# Copy to .env (never commit .env). Placeholders only.

# Database password for the compose "db" service (long random string).
POSTGRES_PASSWORD=change-me-long-random

# 32 random bytes, base64. Generate with:  openssl rand -base64 32
# Keep a safe copy: without it, stored Marafiq / mail passwords cannot be decrypted.
ENCRYPTION_KEY=

# Address users open; used in invitation and password-reset links.
PUBLIC_URL=https://sonu.example.com

# Host port of the app container (Cloudflare Tunnel service URL: http://localhost:8091).
SONU_PORT=8091

# "1" = trust the proxy in front on a private network (Cloudflare Tunnel). "0" when exposed directly.
TRUST_PROXY=1

# Local development without Docker: leave DATABASE_URL empty and `npm run dev` in server/
# starts an embedded PostgreSQL. With docker-compose.dev.yml use:
# DATABASE_URL=postgres://sonu:sonu-dev@localhost:54329/sonu
