{
  "name": "@sonu/worker",
  "version": "0.1.0",
  "private": true,
  "description": "SONU read-only background connection worker for the Marafiq portal (plus a local mock portal for tests).",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.json --noEmit",
    "build:src": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "mock": "tsx mock-portal/start.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "playwright": "1.65.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "exceljs": "4.4.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
